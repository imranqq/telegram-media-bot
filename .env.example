# Токен бота из @BotFather — обязателен. Вставьте его после BOT_TOKEN=
BOT_TOKEN=

# Базовый URL Telegram Bot API.
# Оставьте пустым для облачного API (лимит загрузки 50 МБ).
# Для локального Bot API server укажите, например: http://localhost:8081
TELEGRAM_API_BASE=

# Лимит размера файла в мегабайтах.
# 50 — облачный Bot API. 2000 — локальный Bot API server.
MAX_UPLOAD_MB=50

# Каталог для временных файлов. Файлы удаляются сразу после отправки.
DOWNLOAD_DIR=/tmp/downloads

# Путь к ffmpeg, если он не в PATH (Windows: C:\ffmpeg\bin\ffmpeg.exe)
FFMPEG_LOCATION=

# cookies.txt из браузера — нужен, если YouTube требует подтверждения "я не робот"
COOKIES_FILE=

# Сколько загрузок выполняется одновременно
MAX_CONCURRENT_DOWNLOADS=2

# Максимум треков из плейлиста/сета
MAX_PLAYLIST_ITEMS=25

# Максимальная длительность трека в минутах
MAX_AUDIO_DURATION_MIN=60

# Предохранитель: сколько минут одна задача может идти, дальше бот её останавливает
JOB_TIMEOUT_MIN=30

# Формат звука по умолчанию для SoundCloud: mp3 | orig
DEFAULT_AUDIO_FORMAT=mp3

# Клиент YouTube (extractor_args). Пусто = по умолчанию.
# Пример если ловите "Sign in to confirm you're not a bot": android,web_safari
YT_PLAYER_CLIENT=

# Режим приёма апдейтов. Пусто = long polling (локальный запуск).
# На Render заполнять не нужно: Render сам подставляет RENDER_EXTERNAL_URL,
# и бот переключается на webhook — так каждое сообщение будит заснувший контейнер.
WEBHOOK_URL=

# Самопинг собственного /health в минутах, чтобы free-план не усыплял сервис.
# Работает только когда известен публичный адрес. 0 — выключить.
KEEPALIVE_MIN=10

# Порт для healthcheck и webhook (Render подставляет свой PORT)
PORT=8080

LOG_LEVEL=INFO
